

:: day_5_1
<<nobr>>
<<removeobjective "day_4">>
<<set $bodyImgFrontClothed = "img/body/body_5/front_clothed.png">>
<<set $bodyImgBackClothed  = "img/body/body_5/back_clothed.png">>
